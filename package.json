{
  "name": "@frank/harness-re-harness",
  "version": "1.4.0",
  "description": "Runtime-neutral Harness compatibility distribution and MCP server",
  "type": "module",
  "bin": {
    "harness-re-harness": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "docs",
    "compat",
    "manifest.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "acceptance": "npm test && node scripts/package-smoke.mjs",
    "prepack": "npm run acceptance"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "typescript": "5.9.2"
  }
}
