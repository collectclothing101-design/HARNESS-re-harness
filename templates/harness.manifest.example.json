{
  "schemaVersion": "1.0.0", "packageVersion": "1.3.0", "name": "software-team",
  "upstream": { "repository": "https://github.com/revfactory/harness", "commit": "cceac68ea1d0ad198ef4b7b906cd238375836387" },
  "agents": [
    { "id": "builder", "role": "implementation", "modelTier": "balanced", "skills": ["implementation"], "tools": ["filesystem","tests"] },
    { "id": "reviewer", "role": "quality review", "modelTier": "reasoning", "skills": ["review"], "tools": ["filesystem","tests"] }
  ],
  "skills": [
    { "id": "implementation", "description": "Implement scoped changes", "triggers": ["implement","fix"] },
    { "id": "review", "description": "Review correctness and risks", "triggers": ["review","audit"] }
  ],
  "workflows": [{ "id": "delivery", "pattern": "producer-reviewer", "nodes": [{ "id": "build", "agent": "builder" }, { "id": "review", "agent": "reviewer" }], "edges": [{ "from": "build", "to": "review" }], "reviewGates": ["review"] }],
  "runtimeRequirements": ["agents","skills","tools","mcp","workflows","review-gates","artifacts"]
}

