{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.local/schemas/harness-manifest-1.0.0.json",
  "title": "HARNESS-re-harness canonical manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","packageVersion","name","upstream","agents","skills","workflows","runtimeRequirements"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "packageVersion": { "const": "1.1.0" },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "upstream": { "type": "object", "additionalProperties": false, "required": ["repository","commit"], "properties": { "repository": { "type": "string", "format": "uri" }, "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" } } },
    "agents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/agent" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "workflows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflow" } },
    "runtimeRequirements": { "type": "array", "items": { "enum": ["agents","teams","skills","tools","mcp","workflows","review-gates","artifacts"] } }
  },
  "$defs": {
    "agent": { "type": "object", "additionalProperties": false, "required": ["id","role","modelTier","skills","tools"], "properties": { "id": { "type": "string" }, "role": { "type": "string" }, "modelTier": { "enum": ["reasoning","balanced","fast"] }, "skills": { "type": "array", "items": { "type": "string" } }, "tools": { "type": "array", "items": { "type": "string" } } } },
    "skill": { "type": "object", "additionalProperties": false, "required": ["id","description","triggers"], "properties": { "id": { "type": "string" }, "description": { "type": "string" }, "triggers": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "workflow": { "type": "object", "additionalProperties": false, "required": ["id","pattern","nodes","edges","reviewGates"], "properties": { "id": { "type": "string" }, "pattern": { "enum": ["pipeline","fan-out-fan-in","expert-pool","producer-reviewer","supervisor","hierarchical-delegation"] }, "executionMode": { "enum": ["workflow-orchestration","persistent-collaboration","subagent-delegation"], "default": "workflow-orchestration" }, "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id","agent"], "properties": { "id": { "type": "string" }, "agent": { "type": "string" } } } }, "edges": { "type": "array", "items": { "type": "object", "required": ["from","to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "condition": { "type": "string" } } } }, "reviewGates": { "type": "array", "items": { "type": "string" } } } }
  }
}

