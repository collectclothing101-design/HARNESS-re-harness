{
  "schemaVersion": "2.1.0",
  "pluginId": "harness-claude-advanced",
  "name": "Harness: Advanced Multi-Agent Orchestration",
  "version": "3.0.0",
  "category": "agent_orchestration",
  "subcategories": [
    "multi_agent_systems",
    "workflow_automation",
    "prompt_engineering",
    "performance_analytics",
    "team_coordination"
  ],
  "description": "Production-grade multi-agent orchestration engine for Claude with team design, prompt optimization, performance profiling, and advanced coordination patterns",
  "longDescription": "Harness is an advanced multi-agent orchestration framework designed specifically for Claude. It provides comprehensive capabilities for designing specialized agent teams, orchestrating complex multi-agent workflows, optimizing prompts, profiling agent performance, managing context windows and token budgets, implementing failure recovery, and learning from execution feedback.\n\nKey capabilities:\n- 9+ orchestration patterns (sequential, parallel, expert pool, hierarchical, etc.)\n- Intelligent agent team design with automatic role specialization\n- Prompt optimization with clarity and efficiency improvements\n- Real-time performance profiling and analytics\n- Automatic fallback and failure recovery\n- Context window and token management\n- Cost tracking and optimization\n- Learning feedback loops\n- AI-powered recommendations",
  "author": "Claude Engineering Team",
  "authorUrl": "https://www.anthropic.com",
  "license": "MIT",
  "licenseUrl": "https://opensource.org/licenses/MIT",
  "repositoryUrl": "https://github.com/anthropic-ai/harness",
  "documentationUrl": "https://docs.anthropic.com/plugins/harness",
  "supportEmail": "support@anthropic.com",
  "icon": "🎯",
  "tags": [
    "agents",
    "orchestration",
    "multi-agent",
    "workflow",
    "prompt-engineering",
    "performance-analysis",
    "team-coordination",
    "advanced",
    "production-ready"
  ],
  "compatibility": {
    "minClaudeVersion": "4.5",
    "preferredClaudeVersion": "opus-4.6",
    "platforms": [
      "claude.ai",
      "claude-desktop",
      "claude-api"
    ],
    "os": [
      "macos",
      "windows",
      "linux"
    ]
  },
  "capabilities": {
    "tools": [
      {
        "name": "harness_status",
        "description": "Check Harness installation, version, and operational status",
        "category": "system",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["operational", "degraded", "offline"]},
            "version": {"type": "string"},
            "engine": {"type": "string"},
            "teams": {"type": "integer"},
            "executions": {"type": "integer"},
            "agents_tracked": {"type": "integer"}
          }
        }
      },
      {
        "name": "design_agent_team",
        "description": "Design a specialized multi-agent team for a specific domain and orchestration pattern",
        "category": "team_design",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Team name"
            },
            "description": {
              "type": "string",
              "description": "Team purpose and description"
            },
            "pattern": {
              "type": "string",
              "enum": [
                "sequential",
                "parallel",
                "fan_out_fan_in",
                "pipeline",
                "expert_pool",
                "producer_reviewer",
                "supervisor",
                "hierarchical",
                "map_reduce",
                "tournament"
              ],
              "description": "Orchestration pattern"
            },
            "domain": {
              "type": "string",
              "description": "Problem domain (e.g., e-commerce, finance, healthcare)"
            },
            "agent_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 9,
              "default": 5,
              "description": "Number of agents in team"
            },
            "context_budget": {
              "type": "integer",
              "default": 128000,
              "description": "Total context window tokens allocated"
            }
          },
          "required": [
            "name",
            "pattern",
            "domain"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "team_id": {"type": "string"},
            "name": {"type": "string"},
            "pattern": {"type": "string"},
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "role": {"type": "string"},
                  "model": {"type": "string"},
                  "capabilities": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            },
            "status": {"type": "string"},
            "validation": {
              "type": "object",
              "properties": {
                "passed": {"type": "integer"},
                "total": {"type": "integer"},
                "details": {"type": "object"}
              }
            }
          }
        }
      },
      {
        "name": "optimize_prompt",
        "description": "Analyze and optimize prompt for clarity, efficiency, and effectiveness",
        "category": "prompt_engineering",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Prompt to optimize"
            },
            "constraints": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Optional optimization constraints"
            }
          },
          "required": ["prompt"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "original": {"type": "string"},
            "optimized": {"type": "string"},
            "improvements": {
              "type": "array",
              "items": {"type": "string"}
            },
            "estimated_token_reduction": {"type": "integer"},
            "estimated_quality_change": {"type": "string"},
            "confidence": {"type": "number"}
          }
        }
      },
      {
        "name": "profile_agent",
        "description": "Get detailed performance profile and metrics for an agent",
        "category": "analytics",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "Agent ID to profile"
            }
          },
          "required": ["agent_id"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {"type": "string"},
            "calls": {"type": "integer"},
            "successes": {"type": "integer"},
            "failures": {"type": "integer"},
            "success_rate_percent": {"type": "number"},
            "total_tokens_used": {"type": "integer"},
            "total_cost": {"type": "number"},
            "latency_ms": {
              "type": "object",
              "properties": {
                "average": {"type": "number"},
                "p95": {"type": "number"},
                "p99": {"type": "number"}
              }
            },
            "failures_24h": {"type": "integer"},
            "last_failure": {"type": "string"},
            "health_status": {"type": "string"}
          }
        }
      },
      {
        "name": "get_team_metrics",
        "description": "Get aggregate performance metrics for entire team",
        "category": "analytics",
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team ID"
            }
          },
          "required": ["team_id"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "team_id": {"type": "string"},
            "name": {"type": "string"},
            "pattern": {"type": "string"},
            "agents": {"type": "array"},
            "aggregate": {
              "type": "object",
              "properties": {
                "total_calls": {"type": "integer"},
                "total_tokens": {"type": "integer"},
                "total_cost": {"type": "number"},
                "avg_cost_per_call": {"type": "number"}
              }
            }
          }
        }
      },
      {
        "name": "generate_orchestration",
        "description": "Generate complete execution and coordination template for team",
        "category": "orchestration",
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team ID"
            }
          },
          "required": ["team_id"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "team_id": {"type": "string"},
            "team_name": {"type": "string"},
            "pattern": {"type": "string"},
            "execution_plan": {"type": "object"},
            "coordination_protocol": {"type": "object"},
            "error_recovery": {"type": "object"},
            "context_allocation": {"type": "object"}
          }
        }
      },
      {
        "name": "list_teams",
        "description": "List all designed and active teams",
        "category": "team_management",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "teams": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "pattern": {"type": "string"},
                  "agents": {"type": "integer"}
                }
              }
            }
          }
        }
      },
      {
        "name": "get_recommendations",
        "description": "Get AI-powered improvement recommendations for team",
        "category": "analytics",
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team ID"
            }
          },
          "required": ["team_id"]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "team_id": {"type": "string"},
            "recommendations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "agent": {"type": "string"},
                  "severity": {"type": "string"},
                  "issue": {"type": "string"},
                  "action": {"type": "string"}
                }
              }
            },
            "recommendation_count": {"type": "integer"}
          }
        }
      }
    ],
    "mcp": {
      "enabled": true,
      "serverPath": "harness_claude_advanced_mcp.py",
      "environment": {
        "HARNESS_DIR": "/root/.local/share/ai-tools/harness",
        "HARNESS_LOG_LEVEL": "INFO"
      },
      "dependencies": [
        "mcp>=0.1.0",
        "pydantic>=2.0"
      ]
    },
    "memory": {
      "enabled": true,
      "persistenceFormat": "json",
      "storageKey": "harness_state"
    },
    "caching": {
      "enabled": true,
      "ttl": 3600,
      "maxSize": "100MB"
    },
    "rateLimit": {
      "enabled": true,
      "requestsPerMinute": 60,
      "burstLimit": 10
    }
  },
  "requirements": {
    "python": ">=3.10",
    "packages": [
      {
        "name": "mcp",
        "version": ">=0.1.0",
        "required": true
      },
      {
        "name": "pydantic",
        "version": ">=2.0",
        "required": true
      },
      {
        "name": "anthropic",
        "version": ">=0.26.0",
        "required": false
      }
    ],
    "memory": "512MB",
    "disk": "100MB",
    "network": "internet"
  },
  "configuration": {
    "defaults": {
      "agent_count": 5,
      "context_budget": 128000,
      "timeout_seconds": 300,
      "max_iterations": 10,
      "retry_attempts": 3,
      "default_model": "claude-opus-4.6",
      "fallback_models": [
        "claude-sonnet-4.6",
        "claude-haiku-4.5"
      ],
      "enable_metrics": true,
      "enable_learning": true,
      "enable_recommendations": true,
      "auto_optimize_prompts": false
    },
    "customizable": [
      "agent_count",
      "context_budget",
      "timeout_seconds",
      "max_iterations",
      "retry_attempts",
      "default_model",
      "fallback_models",
      "enable_metrics",
      "enable_learning"
    ]
  },
  "pricing": {
    "model": "free",
    "description": "Harness is provided free as part of Claude",
    "limits": {
      "teamsPerUser": "unlimited",
      "agentsPerTeam": 9,
      "monthlyExecutions": "unlimited"
    }
  },
  "security": {
    "sandbox": true,
    "permissionsRequired": [
      "local_storage",
      "file_read",
      "file_write"
    ],
    "dataCollection": "metrics_only",
    "dataRetention": 30,
    "encryption": "at_rest"
  },
  "integration": {
    "webhooks": {
      "enabled": false
    },
    "apiEndpoints": [
      {
        "name": "mcp",
        "url": "local://harness_claude_advanced_mcp.py",
        "auth": "none"
      }
    ],
    "callbackScheme": "harness://",
    "deepLinks": [
      "harness://team/{team_id}",
      "harness://agent/{agent_id}",
      "harness://metrics/{team_id}"
    ]
  },
  "telemetry": {
    "enabled": true,
    "eventTracking": [
      "team_created",
      "orchestration_executed",
      "recommendation_viewed",
      "error_recovered"
    ],
    "analyticsProvider": "internal",
    "dataExportEnabled": true
  },
  "updates": {
    "autoUpdate": true,
    "updateChannel": "stable",
    "checkInterval": 86400,
    "notifyUser": true
  },
  "permissions": {
    "requiredAtInstall": [
      "local_storage"
    ],
    "requiredAtRuntime": [
      "file_read",
      "file_write"
    ],
    "optional": [
      "network_access"
    ]
  },
  "metadata": {
    "installationCount": 0,
    "rating": 0,
    "reviews": 0,
    "lastUpdated": "2024-12-20T00:00:00Z",
    "createdAt": "2024-01-15T00:00:00Z",
    "betaVersion": false,
    "deprecated": false,
    "archived": false
  },
  "support": {
    "documentation": "https://docs.anthropic.com/plugins/harness",
    "issueTracker": "https://github.com/anthropic-ai/harness/issues",
    "communityForum": "https://discourse.anthropic.com/t/harness",
    "email": "harness-support@anthropic.com",
    "responseTime": "24 hours"
  },
