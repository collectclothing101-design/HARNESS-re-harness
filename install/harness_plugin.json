      ]
    }
  ],
  "verificationStatus": "verified",
  "verificationDate": "2024-12-20",
  "complianceStandards": [
    "SOC2",
    "ISO27001",
    "GDPR"
  ],
  "accessibility": {
    "wcagCompliance": "AA",
    "screenReaderSupport": true,
    "keyboardNavigation": true
  },
  "deployment": {
    "docker": {
      "enabled": true,
      "dockerfile": "Dockerfile.harness",
      "registry": "ghcr.io/anthropic-ai/harness",
      "tags": [
        "latest",
        "3.0.0",
        "stable"
      ]
    },
    "kubernetes": {
      "enabled": true,
      "helmChart": "harness"
    },
    "serverless": {
      "enabled": true,
      "platforms": [
        "aws-lambda",
        "gcp-cloud-functions",
        "azure-functions"
      ]
    }
  }
}
