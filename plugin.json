{
  "id": "harness-claude",
  "name": "Harness Claude",
  "version": "2.0.0",
  "author": {
    "name": "Anthropic",
    "email": "harness@anthropic.com",
    "url": "https://anthropic.com"
  },
  "description": "Production-grade multi-agent orchestration framework for Claude with real-time execution, performance profiling, and skill generation",
  "longDescription": "Harness Claude enables sophisticated multi-agent system design, execution, and optimization. Features: 6 architectural patterns, real-time orchestration with failover, distributed tracing, performance profiling, skill generation via skill-creator integration, plugin ecosystem, cost management, compliance & audit logging, and chaos testing.",
  "keywords": [
    "multi-agent",
    "orchestration",
    "workflow",
    "distributed-systems",
    "profiling",
    "monitoring",
    "skill-generation",
    "plugin-ecosystem"
  ],
  "category": "orchestration",
  "tags": [
    "agents",
    "orchestration",
    "workflow",
    "performance",
    "monitoring",
    "skills",
    "plugins",
    "enterprise"
  ],
  "license": "MIT",
  "homepage": "https://github.com/anthropic/harness-claude",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropic/harness-claude.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/anthropic/harness-claude/issues",
    "email": "support@anthropic.com"
  },
  "documentation": {
    "overview": "https://harness-claude.anthropic.com/docs",
    "api": "https://harness-claude.anthropic.com/docs/api",
    "examples": "https://harness-claude.anthropic.com/docs/examples",
    "troubleshooting": "https://harness-claude.anthropic.com/docs/troubleshooting"
  },
  "capabilities": {
    "core": [
      "agent-team-design",
      "multi-pattern-orchestration",
      "real-time-execution",
      "skill-scaffolding",
      "validation-certification",
      "performance-profiling",
      "distributed-tracing",
      "skill-creator-integration"
    ],
    "advanced": [
      "adaptive-routing",
      "hierarchical-teams",
      "distributed-execution",
      "advanced-scheduling",
      "error-recovery",
      "state-machine-workflows",
      "observability-integration",
      "compliance-audit-logging",
      "caching-memoization",
      "chaos-testing",
      "cost-optimization"
    ]
  },
  "patterns": [
    {
      "id": "pipeline",
      "name": "Sequential Pipeline",
      "description": "Linear workflow: A → B → C",
      "use_cases": [
        "data-processing-chains",
        "ETL-pipelines",
        "sequential-transformations"
      ]
    },
    {
      "id": "fan-out-fan-in",
      "name": "Fan-Out/Fan-In",
      "description": "Parallel workers with aggregation",
      "use_cases": [
        "parallel-processing",
        "batch-workloads",
        "data-aggregation"
      ]
    },
    {
      "id": "expert-pool",
      "name": "Expert Pool Router",
      "description": "Router-based specialist selection",
      "use_cases": [
        "query-routing",
        "load-balancing",
        "skill-selection"
      ]
    },
    {
      "id": "producer-reviewer",
      "name": "Producer-Reviewer",
      "description": "Quality-gated workflows",
      "use_cases": [
        "content-review",
        "quality-assurance",
        "approval-workflows"
      ]
    },
    {
      "id": "supervisor",
      "name": "Supervisor Pattern",
      "description": "Autonomous team with oversight",
      "use_cases": [
        "autonomous-systems",
        "self-managing-teams",
        "error-recovery"
      ]
    },
    {
      "id": "hierarchical",
      "name": "Hierarchical Delegation",
      "description": "Multi-level delegation trees",
      "use_cases": [
        "complex-workflows",
        "nested-execution",
        "tree-structured-tasks"
      ]
    }
  ],
  "tools": {
    "core": [
      {
        "name": "harness_design_team",
        "description": "Design specialist agent teams using proven patterns",
        "category": "design",
        "parameters": {
          "pattern": {
            "type": "string",
            "enum": [
              "pipeline",
              "fan-out-fan-in",
              "expert-pool",
              "producer-reviewer",
              "supervisor",
              "hierarchical"
            ],
            "description": "Architectural pattern for team"
          },
          "agent_count": {
            "type": "integer",
            "minimum": 2,
            "maximum": 50,
            "description": "Number of agents in team"
          },
          "descriptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Agent role descriptions"
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "team_id": { "type": "string" },
            "team_definition": { "type": "object" },
            "validation_report": { "type": "object" },
            "recommendations": { "type": "array" }
          }
        }
      },
      {
        "name": "harness_execute_team",
        "description": "Execute agent team with real-time orchestration",
        "category": "execution",
        "parameters": {
          "team_id": { "type": "string" },
          "input": { "type": "object" },
          "config": { "type": "object" }
        },
        "output": {
          "type": "object",
          "properties": {
            "result": { "type": "object" },
            "execution_trace": { "type": "object" },
            "telemetry": { "type": "object" }
          }
        }
      },
      {
        "name": "harness_profile_execution",
        "description": "Analyze performance metrics and identify bottlenecks",
        "category": "profiling",
        "parameters": {
          "execution_id": { "type": "string" },
          "metrics": { "type": "array" }
        },
        "output": {
          "type": "object",
          "properties": {
            "profile": { "type": "object" },
            "flamegraph": { "type": "string" },
            "recommendations": { "type": "array" }
          }
        }
      },
      {
        "name": "harness_generate_skill",
        "description": "Generate SKILL.md from agent team",
        "category": "generation",
        "parameters": {
          "team_id": { "type": "string" },
          "tier_split": {
            "type": "object",
            "properties": {
              "core": { "type": "integer" },
              "advanced": { "type": "integer" }
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "skill_md": { "type": "string" },
            "json_schema": { "type": "object" },
            "test_fixtures": { "type": "array" }
          }
        }
      },
      {
        "name": "harness_validate_team",
        "description": "Certification: verify team completeness and compliance",
        "category": "validation",
        "parameters": {
          "team_id": { "type": "string" },
          "sla_config": { "type": "object" }
        },
        "output": {
          "type": "object",
          "properties": {
            "pass": { "type": "boolean" },
            "checks": { "type": "array" },
            "remediation": { "type": "array" }
          }
        }
      },
      {
        "name": "harness_export_metrics",
        "description": "Export metrics for observability systems",
        "category": "observability",
        "parameters": {
          "team_id": { "type": "string" },
          "format": {
            "type": "string",
            "enum": [
              "opentelemetry",
              "prometheus",
              "json",
              "csv"
            ]
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "metrics": { "type": "object" }
          }
        }
      },
      {
        "name": "harness_optimize_cost",
        "description": "Analyze costs and recommend optimizations",
        "category": "optimization",
        "parameters": {
          "team_id": { "type": "string" },
          "timeframe": { "type": "string" }
        },
        "output": {
          "type": "object",
          "properties": {
            "cost_report": { "type": "object" },
            "recommendations": { "type": "array" },
            "impact": { "type": "object" }
          }
        }
      },
      {
        "name": "harness_deploy_distributed",
        "description": "Deploy team across multiple machines",
        "category": "deployment",
        "parameters": {
          "team_id": { "type": "string" },
          "machines": { "type": "array" },
          "strategy": { "type": "string" }
        },
        "output": {
          "type": "object",
          "properties": {
            "deployment_config": { "type": "object" },
            "status": { "type": "string" }
          }
        }
      }
    ],
    "advanced": [
      {
        "name": "harness_adaptive_routing",
        "description": "ML-driven contextual agent selection",
        "category": "learning"
      },
      {
        "name": "harness_chaos_test",
        "description": "Failure injection resilience testing",
        "category": "testing"
      },
      {
        "name": "harness_state_machine",
        "description": "Explicit workflow state management",
        "category": "workflow"
      },
      {
        "name": "harness_compliance_audit",
        "description": "Enterprise compliance & audit logging",
        "category": "compliance"
      },
      {
        "name": "harness_distributed_trace",
        "description": "Cross-boundary distributed tracing",
        "category": "observability"
      },
      {
        "name": "harness_plugin_registry",
        "description": "Extensible agent plugin ecosystem",
        "category": "plugins"
      }
    ]
  },
  "dependencies": {
    "python": {
      "version": ">=3.9",
      "packages": [
        {
          "name": "mcp",
          "version": ">=0.1.0"
        },
        {
          "name": "pydantic",
          "version": ">=2.0"
        },
        {
          "name": "aiofiles",
          "version": ">=23.0"
        },
        {
          "name": "opentelemetry-api",
          "version": ">=1.0"
        },
        {
          "name": "opentelemetry-sdk",
          "version": ">=1.0"
        }
      ]
    },
    "system": [
      {
        "name": "git",
        "version": ">=2.30"
      },
      {
        "name": "python3",
        "version": ">=3.9"
      }
    ]
  },
  "configuration": {
    "harness_dir": {
      "type": "string",
      "description": "Root directory for Harness installation",
      "default": "~/.local/share/ai-tools/harness"
    },
    "mcp_dir": {
      "type": "string",
      "description": "MCP server installation directory",
      "default": "~/.local/share/ai-tools/mcp"
    },
    "cache_enabled": {
      "type": "boolean",
      "description": "Enable execution caching",
      "default": true
    },
    "cache_ttl_seconds": {
      "type": "integer",
      "description": "Cache time-to-live in seconds",
      "default": 3600
    },
    "telemetry_enabled": {
      "type": "boolean",
      "description": "Enable OpenTelemetry export",
      "default": true
    },
    "audit_logging_enabled": {
      "type": "boolean",
      "description": "Enable immutable audit logging",
      "default": true
    },
    "default_timeout_ms": {
      "type": "integer",
      "description": "Default execution timeout in milliseconds",
      "default": 30000
    }
  },
  "permissions": [
    "read:teams",
    "write:teams",
    "execute:teams",
    "read:metrics",
    "read:logs",
    "write:logs",
    "read:config",
    "write:config"
  ],
  "integrations": {
    "skill-creator": {
      "enabled": true,
      "auto_register": true,
      "description": "Auto-generate skill manifests from teams"
    },
    "claude-desktop": {
      "enabled": true,
      "config_path": "~/.config/claude/claude_desktop_config.json",
      "description": "MCP plugin for Claude Desktop"
    },
    "github-actions": {
      "enabled": true,
      "workflow_template": "https://github.com/anthropic/harness-claude/blob/main/.github/workflows/deploy.yml",
      "description": "CI/CD integration for team deployment"
    },
    "opentelemetry": {
      "enabled": true,
      "exporters": [
        "jaeger",
        "prometheus",
        "datadog"
      ],
      "description": "Observability stack integration"
    },
    "kubernetes": {
      "enabled": true,
      "description": "Distributed deployment to K8s"
    }
  },
  "supported_platforms": [
    {
      "os": "macos",
      "architecture": [
        "arm64",
        "x86_64"
      ]
    },
    {
      "os": "linux",
      "architecture": [
        "x86_64",
        "arm64"
      ]
    },
    {
      "os": "windows",
      "architecture": [
        "x86_64"
      ]
    }
  ],
  "installation": {
    "methods": [
      {
        "type": "bash",
        "command": "bash ./install_harness.sh",
        "platforms": [
          "macos",
          "linux"
        ]
      },
      {
        "type": "powershell",
        "command": "powershell -ExecutionPolicy RemoteSigned -File .\\install_harness.ps1",
        "platforms": [
          "windows"
        ]
      },
      {
        "type": "docker",
        "command": "docker run -it harness-claude:latest",
        "platforms": [
          "macos",
          "linux",
          "windows"
        ]
      }
    ]
  },
  "scripts": {
    "install": "bash ./install_harness.sh",
    "install:windows": "powershell -ExecutionPolicy RemoteSigned -File .\\install_harness.ps1",
    "test": "python3 -m pytest tests/ -v",
    "test:integration": "python3 -m pytest tests/integration/ -v",
    "test:chaos": "python3 -m pytest tests/chaos/ -v",
    "lint": "pylint harness_mcp_server.py",
    "format": "black harness_mcp_server.py",
    "docs": "python3 -m mkdocs serve",
    "build": "python3 setup.py build",
    "release": "python3 -m twine upload dist/*"
  },
  "environment": {
    "HARNESS_DIR": {
      "description": "Root directory for Harness",
      "default": "~/.local/share/ai-tools/harness"
    },
    "MCP_DIR": {
      "description": "MCP server directory",
      "default": "~/.local/share/ai-tools/mcp"
    },
    "HARNESS_LOG_LEVEL": {
      "description": "Logging level (DEBUG, INFO, WARNING, ERROR)",
      "default": "INFO"
    },
    "HARNESS_TELEMETRY_EXPORT_INTERVAL": {
      "description": "Telemetry export interval in seconds",
      "default": "60"
    },
    "OPENTELEMETRY_EXPORTER_JAEGER_AGENT_HOST": {
      "description": "Jaeger agent hostname",
      "default": "localhost"
    },
    "OPENTELEMETRY_EXPORTER_JAEGER_AGENT_PORT": {
      "description": "Jaeger agent port",
      "default": "6831"
    }
  },
  "versioning": {
    "semver": true,
    "breaking_changes": [
      {
        "version": "2.0.0",
        "changes": [
          "Redesigned orchestration API",
          "Added distributed tracing",
          "Enhanced profiling system"
        ]
      }
    ]
  },
  "roadmap": {
    "current": "2.0.0",
    "next_features": [
      "Marketplace for agent plugins",
      "Native language support (Go, Rust)",
      "WebAssembly agent support",
      "Hardware acceleration (GPU)",
      "Multi-cloud deployment"
    ]
  },
  "metrics": {
    "github_stars": 0,
    "github_forks": 0,
    "downloads": 0,
    "active_users": 0
  },
  "changelog_url": "https://github.com/anthropic/harness-claude/blob/main/CHANGELOG.md",
  "status": "production",
  "stability": "stable",
  "support_level": "enterprise"
}
